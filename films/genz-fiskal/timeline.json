 "cues": [
  {
   "id": "L00",
   "t": 1.313,
   "text": "Warta Kilat Nusantara! Kabar ekonomi pekan ini!",
   "spoken": 3.002,
   "t1": 4.915
  },
  {
   "id": "L01",
   "t": 5.602,
   "text": "Kabar gembira dari Badan Pusat Statistik!",
   "spoken": 2.178,
   "t1": 7.964
  },
  {
   "id": "L02",
   "t": 8.014,
   "text": "Pengangguran nasional turun ke 4,65%.",
   "spoken": 2.999,
   "t1": 11.258
  },
  {
   "id": "L03",
   "t": 11.308,
   "text": "Terendah sejak tahun 1994!",
   "spoken": 2.304,
   "t1": 14.212
  },
  {
   "id": "L04",
   "t": 14.72,
   "text": "Tapi tunggu dulu, Saudara-saudara.",
   "spoken": 2.837,
   "t1": 18.02
  },
  {
   "id": "L05",
   "t": 18.07,
   "text": "Usia 15 sampai 24 tahun: angkanya malah naik.",
   "spoken": 3.777,
   "t1": 22.1
  },
  {
   "id": "L06",
   "t": 22.15,
   "text": "17,37%!",
   "spoken": 2.136,
   "t1": 24.589
  },
  {
   "id": "L07",
   "t": 24.639,
   "text": "Lebih dari 1 dari 6 pencari kerja muda masih menganggur.",
   "spoken": 3.892,
   "t1": 29.131
  },
  {
   "id": "L08",
   "t": 29.334,
   "text": "Cikarang, Mei 2025.",
   "spoken": 2.182,
   "t1": 31.875
  },
  {
   "id": "L09",
   "t": 31.925,
   "text": "Sekitar 25.000 pelamar menyerbu satu bursa kerja.",
   "spoken": 3.615,
   "t1": 35.86
  },
  {
   "id": "L10",
   "t": 35.91,
   "text": "Lowongannya cuma ribuan. Ada yang sampai pingsan!",
   "spoken": 3.02,
   "t1": 39.53
  },
  {
   "id": "L11",
   "t": 40.557,
   "text": "Yang sudah kerja pun belum tentu aman.",
   "spoken": 1.825,
   "t1": 42.627
  },
  {
   "id": "L12",
   "t": 42.677,
   "text": "Hampir 60% pekerja kita ada di sektor informal.",
   "spoken": 3.577,
   "t1": 46.854
  },
  {
   "id": "L13",
   "t": 47.354,
   "text": "Sekarang kita ke pabrik!",
   "spoken": 1.199,
   "t1": 48.804
  },
  {
   "id": "L14",
   "t": 48.854,
   "text": "Sukoharjo, 1 Maret 2025.",
   "spoken": 2.585,
   "t1": 52.039
  },
  {
   "id": "L15",
   "t": 52.168,
   "text": "Raksasa tekstil Sritex berhenti total.",
   "spoken": 2.613,
   "t1": 55.067
  },
  {
   "id": "L16",
   "t": 55.117,
   "text": "10.665 pekerja pulang tanpa pekerjaan.",
   "spoken": 3.86,
   "t1": 59.577
  },
  {
   "id": "L17",
   "t": 60.605,
   "text": "Sepanjang 2025, Kemnaker mencatat 88.519 korban PHK.",
   "spoken": 5.495,
   "t1": 66.049
  },
  {
   "id": "L18",
   "t": 66.099,
   "text": "Naik 13,54% dari tahun sebelumnya!",
   "spoken": 2.237,
   "t1": 68.684
  },
  {
   "id": "L19",
   "t": 68.734,
   "text": "Tahun ini, sampai September: 63.789 orang.",
   "spoken": 3.777,
   "t1": 72.742
  },
  {
   "id": "L20",
   "t": 72.792,
   "text": "Jawa Barat paling banyak!",
   "spoken": 1.387,
   "t1": 74.436
  },
  {
   "id": "L21a",
   "t": 74.486,
   "text": "Dan itu baru yang tercatat.",
   "spoken": 1.764,
   "t1": 76.2
  },
  {
   "id": "L21b",
   "t": 76.25,
   "text": "Kata serikat buruh, angka aslinya lebih besar.",
   "spoken": 2.971,
   "t1": 79.821
  },
  {
   "id": "L22",
   "t": 84.204,
   "text": "Lalu, ke mana uang negara mengalir?",
   "spoken": 2.337,
   "t1": 86.947
  },
  {
   "id": "L23",
   "t": 86.997,
   "text": "Tahun ini, belanja negara diproyeksi Rp3.942,4 triliun.",
   "spoken": 4.387,
   "t1": 91.984
  },
  {
   "id": "L24",
   "t": 92.079,
   "text": "Makan Bergizi Gratis: Rp335 triliun.",
   "spoken": 3.312,
   "t1": 95.698
  },
  {
   "id": "L25",
   "t": 95.748,
   "text": "Bunga utang saja: Rp599,44 triliun.",
   "spoken": 2.753,
   "t1": 98.772
  },
  {
   "id": "L26",
   "t": 98.822,
   "text": "Itu hampir seperlima pendapatan negara!",
   "spoken": 2.241,
   "t1": 101.663
  },
  {
   "id": "L27",
   "t": 102.219,
   "text": "Belanja lari lebih kencang dari pemasukan.",
   "spoken": 3.219,
   "t1": 105.811
  },
  {
   "id": "L28",
   "t": 105.861,
   "text": "Defisit diperkirakan 2,85% dari PDB.",
   "spoken": 3.435,
   "t1": 109.583
  },
  {
   "id": "L29",
   "t": 109.633,
   "text": "Batasnya? 3%!",
   "spoken": 1.869,
   "t1": 112.102
  },
  {
   "id": "L30a",
   "t": 112.423,
   "text": "Di Senayan, ada yang mengingatkan:",
   "spoken": 2.097,
   "t1": 114.47
  },
  {
   "id": "L30b",
   "t": 114.52,
   "text": "target pajak tahun ini terlalu tinggi.",
   "spoken": 2.354,
   "t1": 117.147
  },
  {
   "id": "L31",
   "t": 117.197,
   "text": "Kalau pemasukan meleset, siapa yang menambal?",
   "spoken": 2.48,
   "t1": 120.277
  },
  {
   "id": "L32",
   "t": 121.461,
   "text": "Sementara itu, di rumah-rumah, dompet makin tipis.",
   "spoken": 4.589,
   "t1": 126.495
  },
  {
   "id": "L33",
   "t": 126.545,
   "text": "Tahun 2019, kelas menengah kita 57,33 juta orang.",
   "spoken": 4.785,
   "t1": 131.728
  },
  {
   "id": "L34a",
   "t": 131.778,
   "text": "Tahun lalu, menurut perkiraan Mandiri Institute,",
   "spoken": 2.932,
   "t1": 134.66
  },
  {
   "id": "L34b",
   "t": 134.71,
   "text": "tinggal 46,7 juta.",
   "spoken": 2.427,
   "t1": 137.737
  },
  {
   "id": "L35",
   "t": 137.908,
   "text": "Berkurang lebih dari 10 juta orang!",
   "spoken": 2.112,
   "t1": 140.403
  },
  {
   "id": "L36",
   "t": 140.453,
   "text": "Calon kelas menengah justru membengkak, jadi 142 juta.",
   "spoken": 4.789,
   "t1": 145.842
  },
  {
   "id": "L37a",
   "t": 146.654,
   "text": "Agustus 2025.",
   "spoken": 1.686,
   "t1": 148.29
  },
  {
   "id": "L37b",
   "t": 148.34,
   "text": "Soal tunjangan DPR, mahasiswa dan warga turun ke jalan.",
   "spoken": 3.565,
   "t1": 152.046
  },
  {
   "id": "L38",
   "t": 152.096,
   "text": "Lahir 17+8 Tuntutan Rakyat.",
   "spoken": 2.612,
   "t1": 154.946
  },
  {
   "id": "L39",
   "t": 154.996,
   "text": "DPR akhirnya menghentikan tunjangan rumah.",
   "spoken": 2.689,
   "t1": 158.285
  },
  {
   "id": "L40",
   "t": 159.816,
   "text": "Angka nasional bilang membaik.",
   "spoken": 1.948,
   "t1": 162.341
  },
  {
   "id": "L41",
   "t": 162.391,
   "text": "Antrean bursa kerja bilang lain.",
   "spoken": 2.167,
   "t1": 165.158
  },
  {
   "id": "L42",
   "t": 166.424,
   "text": "Warta Kilat Nusantara!",
   "spoken": 1.741,
   "t1": 168.765
  }
 ],
